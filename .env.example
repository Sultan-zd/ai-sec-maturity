# Copier ce fichier en .env (jamais commité) et remplacer chaque valeur.
# Générer un secret : openssl rand -base64 48

POSTGRES_PASSWORD=change-me-postgres
AIMA_JWT_SECRET=change-me-at-least-32-random-characters-xxxxxxxx
AIMA_ADMIN_EMAIL=admin@aima.local
AIMA_ADMIN_PASSWORD=change-me-Admin@2026!
# Port HTTP publié sur le poste (8080-8085 sont souvent déjà pris)
AIMA_HTTP_PORT=8088
